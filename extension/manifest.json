{
  "manifest_version": 3,
  "name": "METAINC 로직분석 수집기",
  "version": "1.2.0",
  "description": "네이버 스토어 상품 페이지를 자동 스크롤로 완전 수집해 로직분석으로 원클릭 전송합니다. 전산 로그인 상태면 로직분석 자동 로그인.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "host_permissions": [
    "https://smartstore.naver.com/*",
    "https://brand.naver.com/*",
    "https://m.brand.naver.com/*",
    "https://logic.metainc.co.kr/*",
    "http://metainc.co.kr/*",
    "https://metainc.co.kr/*",
    "http://www.metainc.co.kr/*",
    "https://www.metainc.co.kr/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "METAINC 로직분석" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://smartstore.naver.com/*",
        "https://brand.naver.com/*",
        "https://m.brand.naver.com/*"
      ],
      "js": ["content-smartstore.js"],
      "css": ["fab.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://logic.metainc.co.kr/*"],
      "js": ["content-logic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://metainc.co.kr/*",
        "http://www.metainc.co.kr/*",
        "https://metainc.co.kr/*",
        "https://www.metainc.co.kr/*"
      ],
      "js": ["content-erp.js"],
      "run_at": "document_idle"
    }
  ]
}

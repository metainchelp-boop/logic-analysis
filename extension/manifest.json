{
  "manifest_version": 3,
  "name": "METAINC 로직분석 수집기",
  "version": "1.0.1",
  "description": "스마트스토어 상품 페이지를 자동 스크롤로 완전 수집해 로직분석으로 원클릭 전송합니다.",
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://smartstore.naver.com/*",
    "https://logic.metainc.co.kr/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "METAINC 로직분석" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://smartstore.naver.com/*"],
      "js": ["content-smartstore.js"],
      "css": ["fab.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://logic.metainc.co.kr/*"],
      "js": ["content-logic.js"],
      "run_at": "document_idle"
    }
  ]
}

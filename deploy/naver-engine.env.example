# 예시만. 코드 폴더 밖 /etc/metainc/naver-engine/runtime.env에 승인 뒤 설치한다.
# Compose >= 2.30, env_file format: raw. 비밀값은 따옴표 없이 원문을 넣는다.
# 이 파일을 source 하거나 실제 값이 든 compose config 출력을 공유하지 않는다.
NAVER_ENGINE_DB=/var/lib/naver-engine/engine.db
NAVER_ENGINE_SOCKET=/run/naver-engine/engine.sock
NAVER_ENGINE_SYNC_ENABLED=false
NAVER_ENGINE_LINKS_ENABLED=false
NAVER_ENGINE_MORNING_ENABLED=false
NAVER_ENGINE_ALERTS_ENABLED=false
NAVER_ENGINE_ISSUE_ALERTS_ENABLED=false
NAVER_ENGINE_BACKUP_ENABLED=false
NAVER_ENGINE_WEB_ENABLED=false

# 실운영 첫 14일은 대표님만 보는 그림자 점검. 날짜·대표 확인은 가동 승인 때 고정한다.
NAVER_ENGINE_SHADOW_START=
NAVER_ENGINE_ISSUE_ALERTS_FROM=
# 비어 있는 값은 실행 승인이 아니다. 실제 키는 이 저장소에 넣지 않는다.
NAVER_ENGINE_ERP_KEY=
NAVER_AUTO_TOKEN_SECRET=
NAVER_MGR_CUSTOMER_ID=
NAVER_MGR_API_KEY=
NAVER_MGR_SECRET_KEY=

# 백업 공개 인증서와 전송 인증키는 복호화 개인키가 아니다.
# 이 세 파일은 기본 compose에 mount하지 않는다. 백업 가동 전 승인된 RO mount가 필요하다.
NAVER_BACKUP_CERT=/run/secrets/naver-backup-recipient.pem
NAVER_BACKUP_SSH_KEY=/run/secrets/naver-backup-upload-key
NAVER_BACKUP_KNOWN_HOSTS=/run/secrets/naver-backup-known-hosts

# ③ 중계 설정은 별도 ③ env에 둔다. 이 예시만으로는 화면이 열리지 않는다.
NAVER_AUTO_WEB=off
NAVER_AUTO_ENGINE=

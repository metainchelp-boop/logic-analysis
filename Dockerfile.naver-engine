# 개발 CI 빌드용. 운영 기동에는 별도 배포 승인이 필요하며 운영 image digest도 별도로 고정한다.
FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Seoul \
    PYTHONPATH=/opt/naver-engine:/opt/naver-engine/backend

# 공개 인증서 CMS 암호화와 받기 전용 SSH 업로드에만 사용한다.
# 복호화 개인키는 이미지에도, 실행 컨테이너에도 넣지 않는다.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 naver-engine \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin naver-engine

WORKDIR /opt/naver-engine
COPY naver_engine/ ./naver_engine/
COPY naver_runtime/ ./naver_runtime/
COPY backend/app/__init__.py ./backend/app/__init__.py
COPY backend/app/naver_auto/ ./backend/app/naver_auto/

USER 10001:10001
# TCP EXPOSE 없음. 웹과 예약 실행은 같은 프로세스·사용자·쓰기 소유자를 사용한다.
CMD ["python", "-m", "naver_runtime", "run"]
